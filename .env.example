# OverSight Configuration

# Gemini API (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# DataHub Integration (Optional)
DATAHUB_SERVER_URL=http://localhost:8080
DATAHUB_TOKEN=your_datahub_token_here
DATAHUB_ENABLED=false

# Redis for Agent Memory (Optional)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Database (Default: SQLite)
# DATABASE_URL=postgresql://user:password@localhost/oversight
# DATABASE_URL=sqlite:///./data/oversight.db
